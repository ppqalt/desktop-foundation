        case Qt.Key_Right:
        case Qt.Key_D:
            return [1, 0];
        case Qt.Key_Up:
        case Qt.Key_W:
            return [0, -1];
        case Qt.Key_Down:
        case Qt.Key_S:
            return [0, 1];
        default:
            return null;
        }
