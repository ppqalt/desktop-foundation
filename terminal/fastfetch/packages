#!/usr/bin/env python3
"""Native Fastfetch total plus an invalidated-on-package-change foreign count."""
import fcntl
import json
import os
from pathlib import Path
import subprocess


def signature(database, repositories):
    paths = [database / 'local', *(database / 'sync' / (repo + '.db') for repo in repositories)]
    stamps = []
    for path in paths:
        try:
            stat = path.stat()
            stamps.append([str(path), stat.st_ino, stat.st_mtime_ns, stat.st_ctime_ns, stat.st_size])
        except FileNotFoundError:
            stamps.append([str(path), None])
    return stamps


def foreign_count(database, repositories, cache):
    cache.parent.mkdir(parents=True, exist_ok=True)
    with cache.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        before = signature(database, repositories)
        transaction = database / 'db.lck'
        try:
            saved = json.loads(cache.read_text())
            if not transaction.exists() and saved['signature'] == before and type(saved['count']) is int and saved['count'] >= 0:
                return saved['count']
        except (OSError, ValueError, KeyError, TypeError):
            pass
        query = subprocess.run(['pacman', '-Qqm'], capture_output=True, text=True, check=False)
        # Empty foreign lists return 1; errors must not silently become zero.
        if query.returncode and (query.returncode != 1 or query.stdout or query.stderr):
            raise RuntimeError(query.stderr.strip() or 'Unable to query foreign packages')
        count = len(query.stdout.splitlines())
        after = signature(database, repositories)
        if before == after and not transaction.exists():
            temporary = cache.with_suffix('.tmp')
            temporary.write_text(json.dumps({'signature': after, 'count': count}))
            temporary.replace(cache)
        return count


def main():
    database = Path(subprocess.check_output(['pacman-conf', 'DBPath'], text=True).strip())
    repositories = subprocess.check_output(['pacman-conf', '--repo-list'], text=True).splitlines()
    cache = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'desktop-foundation/fastfetch-foreign.json'
    count = foreign_count(database, repositories, cache)
    total = subprocess.check_output(['fastfetch', '--config', str(Path(__file__).with_name('packages.jsonc')), '--pipe', 'true'], text=True).strip()
    print(f'{total}, {count} (AUR)')


if __name__ == '__main__':
    main()
