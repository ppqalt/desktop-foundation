{
  "logo": {
    "source": "arch",
    "padding": {
      "left": 1,
      "right": 4
    },
    "color": {
      "1": "38;2;121;184;212",
      "2": "38;2;121;184;212"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;137;147;163"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "key": "OS      ",
      "format": "{name} {arch}"
    },
    {
      "type": "title",
      "key": "Host    ",
      "format": "{host-name}"
    },
    {
      "type": "kernel",
      "key": "Kernel  ",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Uptime  "
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    "break",
    {
      "type": "shell",
      "key": "Shell   ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "Desktop ",
      "format": "{pretty-name} {version} \u00b7 {protocol-name}"
    },
    {
      "type": "display",
      "key": "Display ",
      "format": "{width} \u00d7 {height} \u00b7 {refresh-rate} Hz"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU     ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU     ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory  ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Disk /  ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    }
  ]
}
