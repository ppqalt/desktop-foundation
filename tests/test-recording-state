#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
base=$(mktemp -d /tmp/foundation-recording-state.XXXXXX)
cleanup() {
	local result=$?
	if ((result != 0)) && [[ -f $base/log ]]; then cat "$base/log" >&2; fi
	rm -r -- "$base"
}
trap cleanup EXIT
mkdir -p "$base/shell" "$base/scripts"
for leaf in home runtime state cache data config; do mkdir -m 700 "$base/$leaf"; done
mkdir -m 700 "$base/runtime/desktop-foundation-recording"
printf '%s\n' '{"phase":"idle"}' >"$base/runtime/desktop-foundation-recording/status.json"
for module in services components theme; do ln -s "$root/shell/$module" "$base/shell/$module"; done
ln -s "$root/theme" "$base/theme"
cp "$root/tests/qml/recording-state.qml" "$base/shell/shell.qml"
cat >"$base/scripts/record" <<'FIXTURE'
#!/bin/sh
file="$XDG_RUNTIME_DIR/desktop-foundation-recording/status.json"
if [ "$1" = fixture-write ]; then
    printf '{"phase":"%s"}\n' "$2" > "$file.next"
    mv "$file.next" "$file"
fi
cat "$file"
FIXTURE
chmod 700 "$base/scripts/record"
env -u WAYLAND_DISPLAY -u DISPLAY -u NIRI_SOCKET -u QS_CONFIG_PATH -u QS_CONFIG_NAME \
	HOME="$base/home" XDG_RUNTIME_DIR="$base/runtime" XDG_STATE_HOME="$base/state" XDG_CACHE_HOME="$base/cache" \
	XDG_DATA_HOME="$base/data" XDG_CONFIG_HOME="$base/config" DF_FOUNDATION_ROOT="$base" \
	DBUS_SESSION_BUS_ADDRESS="unix:path=$base/absent-user-bus" DBUS_SYSTEM_BUS_ADDRESS="unix:path=$base/absent-system-bus" \
	QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=basic QT_QUICK_BACKEND=software timeout 9s quickshell --path "$base/shell" >"$base/log" 2>&1
rg -q 'RECORDING_STATE_PASS' "$base/log"
if rg -q 'FAIL!|TypeError|ReferenceError|Failed to load configuration' "$base/log"; then exit 1; fi
printf '%s\n' 'PASS recording-state publication, finalization indicator and clock toggles (no capture)'
