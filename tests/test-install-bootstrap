#!/usr/bin/env bash
# Exercise the public wrapper with inert provisioners and private state.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
base=$(mktemp -d /tmp/df-install-bootstrap.XXXXXXXX)
trap 'rm -r -- "$base"' EXIT
mkdir -p "$base/repo/scripts" "$base/state" "$base/home"
# Substitute only the host UID getter in this private copy; production has no
# test override. All bootstrap/argument/ownership logic remains the actual script.
sed "s/\${EUID}/\${DF_FIXTURE_UID}/g" "$root/scripts/install" >"$base/repo/scripts/install"
export DF_FIXTURE_UID=1000
cp "$root/scripts/install-all" "$root/scripts/install-core" "$base/repo/scripts/"
cat >"$base/repo/scripts/boot-integrate" <<'SH'
#!/bin/sh
printf '%s\n' "$*" >> "$DF_TEST_BOOT_LOG"
[ "${DF_TEST_BOOT_BLOCK:-0}" != 1 ]
SH
cat >"$base/repo/scripts/bootstrap" <<'SH'
#!/bin/sh
printf 'bootstrap\n' >> "$DF_TEST_LOG"
SH
cat >"$base/repo/scripts/build-backend" <<'SH'
#!/bin/sh
printf 'build\n' >> "$DF_TEST_LOG"
mkdir -p "$(dirname "$0")/../native/foundation/target/release"
cat > "$(dirname "$0")/../native/foundation/target/release/desktop-foundationctl" <<'BIN'
#!/bin/sh
printf '{"sources":{"matchesBinary":%s}}\n' "${DF_FIXTURE_CURRENT:-true}"
BIN
chmod +x "$(dirname "$0")/../native/foundation/target/release/desktop-foundationctl"
SH
cat >"$base/repo/scripts/foundation" <<'SH'
#!/bin/sh
printf 'foundation %s\n' "$*" >> "$DF_TEST_LOG"
SH
chmod +x "$base/repo/scripts/"*
export HOME="$base/home" XDG_STATE_HOME="$base/state" DF_TEST_LOG="$base/log" DF_TEST_BOOT_LOG="$base/boot-log"
# Invalid commands must fail before either compiler or provisioner is touched.
for mode in missing present; do
	if [[ $mode == present ]]; then
		"$base/repo/scripts/build-backend"
		rm "$base/log"
	fi
	for invalid in --typo --extra '--extra recording --extra recording' '--core --standard' '--profile ../default' '--profile=' '--dry-run --check' '--personal --extra recording' '--boot-profile invalid' '--boot-profile eac --clean-boot'; do
		read -r -a options <<<"$invalid"
		if "$base/repo/scripts/install" "${options[@]}" >"$base/error" 2>&1; then exit 1; fi
		[[ ! -e $base/log ]]
	done
	"$base/repo/scripts/install" --help >"$base/help"
	rg -q -- '--patched-niri' "$base/help"
	[[ ! -e $base/log ]]
	if [[ $mode == present ]]; then rm "$base/repo/native/foundation/target/release/desktop-foundationctl"; fi
done

if DF_FIXTURE_UID=0 "$base/repo/scripts/install" --core >"$base/root-error" 2>&1; then exit 1; fi
rg -q 'normal login user' "$base/root-error"
[[ ! -e $base/log ]]
if DF_TEST_BOOT_BLOCK=1 "$base/repo/scripts/install" --core >"$base/blocked" 2>&1; then exit 1; fi
[[ ! -e $base/log ]]
"$base/repo/scripts/install" --core
rg -q 'preflight --admin --summary' "$base/boot-log"
[[ $(cat "$base/log") == $'bootstrap\nbuild\nfoundation install --core' ]]
rm "$base/log"
"$base/repo/scripts/install-all"
[[ $(cat "$base/log") == $'build\nfoundation install --personal' ]]
rm "$base/log"
if DF_FIXTURE_CURRENT=false "$base/repo/scripts/install" --dry-run >"$base/stale" 2>&1; then exit 1; fi
[[ ! -e $base/log ]]
"$base/repo/scripts/install" --dry-run
[[ $(cat "$base/log") == 'foundation install --dry-run' ]]
rm "$base/repo/native/foundation/target/release/desktop-foundationctl" "$base/log"
"$base/repo/scripts/install" --core --no-packages
[[ $(cat "$base/log") == $'build\nfoundation install --core --no-packages' ]]
rm "$base/repo/native/foundation/target/release/desktop-foundationctl" "$base/log"
if "$base/repo/scripts/install" --dry-run >/dev/null 2>&1; then exit 1; fi
[[ ! -e $base/log ]]
mkdir -p "$base/state/desktop-foundation"
printf '{"root":"/different/checkout"}\n' >"$base/state/desktop-foundation/manifest.json"
if "$base/repo/scripts/install" --core >/dev/null 2>&1; then exit 1; fi
[[ ! -e $base/log ]]
printf 'invalid json\n' >"$base/state/desktop-foundation/manifest.json"
if "$base/repo/scripts/install" --core >/dev/null 2>&1; then exit 1; fi
[[ ! -e $base/log ]]
printf '{"root":"%s"}\n' "$base/repo" >"$base/state/desktop-foundation/manifest.json"
"$base/repo/scripts/install" --core
[[ $(cat "$base/log") == $'bootstrap\nbuild\nfoundation install --core' ]]
printf '%s\n' 'PASS fresh bootstrap, inspection, no-packages and ownership protection'
