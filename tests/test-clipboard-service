#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
base=$(mktemp -d /tmp/foundation-clipboard-service.XXXXXX)
cleanup() {
	local result=$?
	if ((result != 0)) && [[ -f $base/log ]]; then cat "$base/log" >&2; fi
	rm -r -- "$base"
}
trap cleanup EXIT
mkdir -p "$base/shell" "$base/native/foundation/target/release"
for leaf in home runtime state cache data config; do mkdir -m 700 "$base/$leaf"; done
ln -s "$root/shell/services" "$base/shell/services"
ln -s "$root/shell/components" "$base/shell/components"
ln -s "$root/shell/theme" "$base/shell/theme"
ln -s "$root/theme" "$base/theme"
ln -s "$DF_TEST_NATIVE_BINARY" "$base/native/foundation/target/release/desktop-foundationctl"
printf '%s' 'private fixture' | "$DF_TEST_NATIVE_BINARY" --root "$root" clipboard --state "$base/history" store text
cp "$root/tests/qml/clipboard-service.qml" "$base/shell/shell.qml"
env -u WAYLAND_DISPLAY -u DISPLAY -u NIRI_SOCKET -u HYPRLAND_INSTANCE_SIGNATURE -u QS_CONFIG_PATH -u QS_CONFIG_NAME -u DF_CLIPBOARD_WORKER \
	HOME="$base/home" XDG_RUNTIME_DIR="$base/runtime" XDG_STATE_HOME="$base/state" XDG_CACHE_HOME="$base/cache" \
	XDG_DATA_HOME="$base/data" XDG_CONFIG_HOME="$base/config" DF_FOUNDATION_ROOT="$root" DF_CLIPBOARD_STATE="$base/history" \
	DBUS_SESSION_BUS_ADDRESS="unix:path=$base/absent-user-bus" DBUS_SYSTEM_BUS_ADDRESS="unix:path=$base/absent-system-bus" \
	QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=basic QT_QUICK_BACKEND=software timeout 10s quickshell --path "$base/shell" >"$base/log" 2>&1
rg -q 'CLIPBOARD_SERVICE_RESULT \{"failures":0\}' "$base/log"
if rg -q 'CLIPBOARD_SERVICE_FAIL|TypeError|ReferenceError|Failed to load configuration' "$base/log"; then exit 1; fi
printf '%s\n' 'PASS clipboard native command, watched history and error states'
