#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp "$root/.motion-test.XXXXXX.qml")
log=$(mktemp)
state=$(mktemp -d)
trap 'rm -f -- "$fixture" "$log"; rmdir -- "$state"' EXIT
cp "$root/tests/qml/motion.qml" "$fixture"
if ! env -u WAYLAND_DISPLAY -u DISPLAY -u DBUS_SESSION_BUS_ADDRESS \
	QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
	DF_FOUNDATION_ROOT="$root" XDG_STATE_HOME="$state" \
	timeout 15s quickshell -p "$fixture" >"$log" 2>&1; then
	cat "$log" >&2
	exit 1
fi
if ! rg -q MOTION_TEST_OK "$log" || rg -q 'FAIL!|ERROR|QML (Warning|Error)|TypeError|ReferenceError|QtQuickTest::fail' "$log"; then
	cat "$log" >&2
	exit 1
fi
printf '%s\n' 'PASS production motion, spring reversal, refresh rates, reduced motion, held controls and popup retirement'
