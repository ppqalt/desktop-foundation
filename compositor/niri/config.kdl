// Primary/reference compositor. Generated deployment adds shared input/visuals,
// clipboard-only screenshots, environment and session startup around this source module.
include "bindings.kdl"
hotkey-overlay { skip-at-startup; }
prefer-no-csd

// The managed compositor feathers workspace edges into the overview backdrop.
// An external workspace shadow would leave a rectangular rim around that fade.
// Ordinary window shadows remain independent.
overview {
    workspace-shadow {
        off
    }
}
