// Primary/reference compositor. Generated deployment adds shared input/visuals,
// clipboard-only screenshots, environment and session startup around this source module.
include "bindings.kdl"
hotkey-overlay { skip-at-startup; }
prefer-no-csd

// Workspace previews have their own shadow, separate from window shadows.
// Avoid the default dark, expanded rectangle against the overview backdrop.
overview {
    workspace-shadow {
        softness 80
        spread -8
        offset x=0 y=0
        color "#00000028"
    }
}
