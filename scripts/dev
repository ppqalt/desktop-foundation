#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
action=${1:-check}
shift || true
case $action in
bootstrap | check | doctor | shell-start | shell-stop) exec "$root/scripts/$action" "$@" ;;
deploy) exec "$root/scripts/deploy" install "$@" ;;
restore) exec "$root/scripts/deploy" restore "$@" ;;
reload)
	"$root/scripts/check"
	if [[ -S ${NIRI_SOCKET:-} ]]; then
		exec niri msg action load-config-file
	fi
	printf '%s\n' 'Niri socket unavailable.' >&2
	exit 1
	;;
bench) exec python3 scripts/bench.py "$@" ;;
test)
	cargo test --locked --manifest-path native/nothing/Cargo.toml
	cargo test --locked --manifest-path native/foundation/Cargo.toml "$@"
	exec "$root/tests/test-material-widgets"
	;;
format)
	while IFS= read -r file; do
		if head -n 1 "$file" | rg -q '^#!/usr/bin/env bash'; then shfmt -w "$file"; fi
	done < <(rg --files scripts terminal/fastfetch)
	while IFS= read -r file; do /usr/lib/qt6/bin/qmlformat -i "$file"; done < <(rg --files shell -g '*.qml')
	;;
lint) exec "$root/scripts/check" "$@" ;;
*)
	echo "Unknown workflow: $action" >&2
	exit 2
	;;
esac
