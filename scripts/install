#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Validate public CLI grammar before bootstrapping can install anything. Rust
# remains authoritative for saved selections, ownership and installation effects.
installer_args=("$@")
layer=''
extras=()
dry=false
check=false
help=false
boot_profile=''
boot_dkms=()
clean_boot=false
for ((i = 0; i < ${#installer_args[@]}; i++)); do
	option=${installer_args[i]}
	case $option in
	--core | --minimal | --standard | --personal)
		selected=${option#--}
		[[ $selected != core ]] || selected=minimal
		if [[ -n $layer && $layer != "$selected" ]]; then
			printf '%s\n' 'Choose one installation profile.' >&2
			exit 2
		fi
		layer=$selected
		;;
	--extra)
		((i += 1))
		extra=${installer_args[i]:-}
		case $extra in steam | spicetify | geode | recording) ;; *)
			printf 'Invalid or missing extra: %s\n' "$extra" >&2
			exit 2
			;;
		esac
		for existing in "${extras[@]}"; do
			if [[ $existing == "$extra" ]]; then
				printf 'Duplicate extra: %s\n' "$extra" >&2
				exit 2
			fi
		done
		extras+=("$extra")
		;;
	--profile | --hardware-profile | --profile=* | --hardware-profile=*)
		if [[ $option == *=* ]]; then selected=${option#*=}; else
			((i += 1))
			selected=${installer_args[i]:-}
		fi
		if [[ ! $selected =~ ^[a-zA-Z0-9_-]+$ || ! -d $root/profiles/$selected ]]; then
			printf 'Invalid or missing hardware profile: %s\n' "$selected" >&2
			exit 2
		fi
		;;
	--boot-profile)
		((i += 1))
		boot_profile=${installer_args[i]:-}
		case $boot_profile in eac | existing) ;; *)
			printf '%s\n' 'Boot profile must be eac or existing.' >&2
			exit 2
			;;
		esac
		;;
	--allow-recovery-only-dkms) boot_dkms=(--allow-recovery-only-dkms) ;;
	--recovery-keys-confirmed) ;;
	--clean-boot) clean_boot=true ;;
	--no-packages | --greeter | --no-greeter | --patched-niri | --stock-niri) ;;
	--dry-run | --plan) dry=true ;;
	--check) check=true ;;
	--help | -h) help=true ;;
	*)
		printf 'Unknown installer option: %s\n' "$option" >&2
		exit 2
		;;
	esac
done
if $dry && $check; then
	printf '%s\n' 'Choose --dry-run or --check.' >&2
	exit 2
fi
if [[ $layer == personal ]] && ((${#extras[@]})); then
	printf '%s\n' '--personal already selects its application extras.' >&2
	exit 2
fi
if [[ $boot_profile == eac ]] && $clean_boot; then
	printf '%s\n' 'EAC boot profile cannot use GRUB --clean-boot.' >&2
	exit 2
fi
if $help; then
	printf '%s\n' 'Usage: scripts/install [--minimal|--standard|--personal] [--extra NAME]' \
		'  --profile NAME       Select a hardware profile' \
		'  --patched-niri       Install managed patched Niri (default)' \
		'  --stock-niri         Restore/preserve stock Niri instead' \
		'  --no-packages        Preserve installed packages; deploy only' \
		'  --greeter            Configure greetd when no other manager owns login' \
		'  --no-greeter         Preserve the existing login manager' \
		'  Default: keep a configured login manager; otherwise install greetd' \
		'  --boot-profile eac|existing  Fresh installs default to EAC; existing installs preserve boot' \
		'  --allow-recovery-only-dkms  Retain unsupported DKMS modules only for conventional kernels' \
		'  --clean-boot         Apply the selected supported boot cleanup' \
		'  --dry-run|--check    Inspect without package or build changes' \
		'Extras: steam, spicetify, geode, recording'
	exit 0
fi
# Provision/build as the login user; sudo is acquired only by the selected steps.
if ! $dry && ! $check && [[ ${EUID} == 0 ]]; then
	printf '%s\n' 'Run the installer as your normal login user, without sudo; it requests administrator authentication when needed. Nothing bootstrapped.' >&2
	exit 1
fi
# Boot preflight precedes even compiler/package bootstrap. Old installations
# without a boot selection preserve their stack; only genuinely fresh installs
# acquire the new EAC default. The native installer repeats this selection.
if ! $dry && ! $check; then
	state_base=${XDG_STATE_HOME:-$HOME/.local/state}
	boot_settings=$(
		/usr/bin/python3 -I - "$state_base/desktop-foundation" "$boot_profile" "${boot_dkms[*]}" <<'PYBOOT'
import pathlib, sys, tomllib
state = pathlib.Path(sys.argv[1])
if not state.is_absolute():
    raise SystemExit('XDG_STATE_HOME must be absolute')
selection = state / 'installation.toml'
saved = tomllib.loads(selection.read_text()) if selection.exists() else {}
value = sys.argv[2]
if not value:
    if selection.exists():
        value = saved.get('boot_profile', 'existing')
    else:
        value = 'existing' if (state / 'manifest.json').exists() else 'eac'
if value not in ('eac', 'existing'):
    raise SystemExit('Invalid saved boot profile')
print(value, 'allow' if sys.argv[3] or saved.get('recovery_only_dkms', False) else 'no')
PYBOOT
	)
	read -r boot_profile boot_allow <<<"$boot_settings"
	if [[ $boot_allow == allow ]]; then boot_dkms=(--allow-recovery-only-dkms); fi
	if [[ $boot_profile == eac ]] && $clean_boot; then
		printf '%s\n' 'EAC boot profile cannot use GRUB --clean-boot.' >&2
		exit 2
	fi
	if [[ $boot_profile == eac ]]; then
		"$root/scripts/boot-integrate" preflight --admin --summary "${boot_dkms[@]}"
	fi
fi
if [[ ! -x $root/native/foundation/target/release/desktop-foundationctl ]]; then
	no_packages=false
	for option in "$@"; do
		case $option in
		--dry-run | --plan | --check | --help | -h)
			printf '%s\n' 'Build the native installer first: scripts/build-backend (scripts/bootstrap supplies missing build tools).' >&2
			exit 1
			;;
		--no-packages) no_packages=true ;;
		esac
	done
	# Do not provision packages from a different checkout before the native
	# installer gets its opportunity to enforce deployment ownership.
	state_base=${XDG_STATE_HOME:-$HOME/.local/state}
	[[ $state_base = /* ]] || {
		printf '%s\n' 'XDG_STATE_HOME must be absolute.' >&2
		exit 1
	}
	manifest="$state_base/desktop-foundation/manifest.json"
	if [[ -e $manifest || -L $manifest ]]; then
		if ! command -v python3 >/dev/null 2>&1; then
			printf '%s\n' 'Python is required to verify existing deployment ownership before bootstrapping.' >&2
			exit 1
		fi
		python3 - "$manifest" "$root" <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(sys.argv[1])
try:
    with path.open("rb") as file:
        contents = file.read(1024 * 1024 + 1)
    if len(contents) > 1024 * 1024:
        raise ValueError("manifest is too large")
    owner = json.loads(contents)["root"]
    if not isinstance(owner, str) or not os.path.isabs(owner):
        raise ValueError("invalid owner")
    if os.path.realpath(owner) != os.path.realpath(sys.argv[2]):
        raise ValueError("a different checkout owns deployment")
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f"Cannot bootstrap this checkout: {error}. Nothing changed.", file=sys.stderr)
    sys.exit(1)
PY
	fi
	if ! $no_packages; then
		"$root/scripts/bootstrap"
	fi
	if ! command -v cargo >/dev/null 2>&1; then
		printf '%s\n' 'Cargo is missing; install the build dependencies before using --no-packages.' >&2
		exit 1
	fi
	"$root/scripts/build-backend"
else
	# A checkout can advance while its compiled installer is still an older
	# version. Run the selected source's orchestrator, including new components.
	# Inspection remains read-only and uses the existing executable.
	inspect=false
	for option in "$@"; do
		case $option in
		--dry-run | --plan | --check | --help | -h) inspect=true ;;
		esac
	done
	if ! $inspect; then
		"$root/scripts/build-backend"
	fi
fi
exec "$root/scripts/foundation" install "$@"
