#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=default
personal=true
greeter=true
packages=true
dry_run=false
clean_boot=false
stage=arguments
begin_stage() {
	stage=$1
	printf "\n%s\n" "$stage"
}
trap 'printf "Installation stopped during %s (line %s). Fix the reported error and rerun the same command; owned config backups are retained.\n" "$stage" "$LINENO" >&2' ERR
while (($#)); do
	case $1 in
	--profile | --hardware-profile)
		profile=${2:?Missing hardware profile}
		shift
		;;
	--core) personal=false ;;
	--personal) personal=true ;;
	--no-greeter) greeter=false ;;
	--greeter) greeter=true ;;
	--no-packages) packages=false ;;
	--clean-boot) clean_boot=true ;;
	--dry-run | --plan) dry_run=true ;;
	-h | --help)
		echo 'Usage: scripts/install [--core|--personal] [--hardware-profile NAME] [--no-greeter] [--no-packages] [--clean-boot] [--dry-run]'
		exit 0
		;;
	*)
		echo "Unknown option: $1" >&2
		exit 2
		;;
	esac
	shift
done
[[ $profile =~ ^[A-Za-z0-9_-]+$ ]] || {
	echo 'Invalid hardware profile' >&2
	exit 2
}
[[ -d $root/profiles/$profile ]] || {
	echo "Unknown hardware profile: $profile" >&2
	exit 2
}
[[ $EUID != 0 ]] || {
	echo 'Run as your login user; builds must not run as root.' >&2
	exit 1
}
manifests=(core)
if $greeter; then manifests+=(greeter); fi
if $personal; then manifests+=(personal); fi
printf 'Niri installation: hardware=%s personal=%s\n' "$profile" "$personal"
if $dry_run; then
	echo 'Firmware (repository preferred; AUR fallback):'
	sed '/^#/d; /^$/d' "$root/packages/firmware.txt"
	if $clean_boot; then echo 'Explicit GRUB/mkinitcpio cleanup enabled: kernel-derived AppArmor, Plymouth removal, fallback images, reversible backups.'; fi
	if $clean_boot; then echo 'Boot optimization: visible GRUB 1s (fractional timeout unsupported), independent mirror timer, Wine direct-executable registration opt-out.'; fi
	for manifest in "${manifests[@]}"; do
		echo "Repository packages ($manifest; package stage=$packages):"
		sed '/^#/d; /^$/d' "$root/packages/$manifest.txt"
	done
	if $personal; then
		echo "Personal package/download stage enabled=$packages. AUR: bootstrap paru as non-root if missing; review PKGBUILD; then:"
		sed '/^#/d; /^$/d' "$root/packages/personal-aur.txt"
		python3 - "$root" <<'PY'
import json, sys
from pathlib import Path
for name, source in json.loads((Path(sys.argv[1]) / 'apps/spotify/sources.json').read_text()).items():
    if isinstance(source, dict) and 'url' in source:
        print(name, source['url'], source['sha256'])
    elif isinstance(source, list):
        for library in source:
            print(library['name'], library['url'], library['sha256'])
PY
	fi
	python3 "$root/scripts/deploy.py" install --profile "$profile" --dry-run
	if $personal; then echo 'Brave: one-time allowlisted preference seeds, backed-up flags, manual Web Store extension links; if browser open, defer to scripts/post-install brave.'; fi
	echo 'Preferences: prefer-dark, adw-gtk3-dark; personal browser: brave-origin-nightly.desktop'
	echo 'Services: enable Bluetooth and AppArmor; session starts PipeWire, portals, polkit, shell, notifications, clipboard and wallpaper.'
	if $greeter; then echo 'System files with backups: /etc/greetd/config.toml /etc/pam.d/greetd; enable greetd (no restart). Matrix-capable tuigreet required.'; fi
	echo 'AppArmor: backed-up /etc/default/grub.d/60-desktop-foundation.cfg; regenerate /boot/grub/grub.cfg; GRUB drop-in support required. Inspect scripts/doctor. Reboot/login required; Spotify login then scripts/post-install spotify.'
	exit 0
fi
command -v pacman >/dev/null || {
	echo 'Arch/CachyOS required.' >&2
	exit 1
}
begin_stage '[1/8] Network and authentication'
if $packages || $personal; then
	python3 - <<'PY'
import urllib.request
for url in ['https://static.rust-lang.org/dist/channel-rust-stable.toml', 'https://aur.archlinux.org/rpc/v5/info?arg[]=paru']:
    try:
        with urllib.request.urlopen(url, timeout=15) as response:
            response.read(1)
    except Exception as error:
        raise SystemExit(f'Network prerequisite unavailable: {url}: {error}')
PY
fi
sudo -v
begin_stage '[2/8] Repository dependencies'
if $packages; then
	options=()
	if $greeter; then options+=(--greeter); fi
	if $personal; then options+=(--personal); fi
	"$root/scripts/bootstrap" "${options[@]}"
fi
begin_stage '[3/8] Personal applications'
if $personal && $packages; then
	"$root/scripts/paru-bootstrap"
	mapfile -t aur < <(sed '/^#/d; /^$/d' "$root/packages/personal-aur.txt")
	paru -S --needed "${aur[@]}"
	"$root/scripts/spotify-setup" install
fi
begin_stage '[4/8] Locked native backend'
"$root/scripts/build-nothing"
begin_stage '[5/8] Capabilities and reversible deployment'
python3 "$root/scripts/preflight.py" --profile "$profile"
python3 "$root/scripts/deploy.py" install --compositor niri --profile "$profile"
begin_stage '[6/8] User preferences'
options=()
if $personal; then options+=(--browser brave-origin-nightly.desktop); fi
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
	python3 "$root/scripts/preferences.py" install "${options[@]}"
else
	dbus-run-session -- python3 "$root/scripts/preferences.py" install "${options[@]}"
fi
if $personal; then "$root/scripts/brave-config" apply; fi
begin_stage '[7/8] System services and login'
sudo systemctl enable bluetooth.service apparmor.service
if $clean_boot; then
	sudo "$root/scripts/boot-setup" install
else
	sudo "$root/scripts/apparmor-setup" install
fi
if $greeter; then sudo "$root/scripts/system-setup" install; fi
if $clean_boot && $greeter; then sudo "$root/scripts/greeter-console-setup" install; fi
if $clean_boot; then sudo "$root/scripts/boot-optimize" install; fi
begin_stage '[8/8] Read-only validation'
options=(--installation)
if ! $greeter; then options+=(--no-greeter); fi
if $personal; then options+=(--personal); fi
"$root/scripts/doctor" "${options[@]}"
printf '\nReboot when ready, select Niri and run scripts/doctor --personal.\nSpotify: sign in once, close it, then scripts/post-install spotify.\nRollback: scripts/uninstall; applications: scripts/spotify-setup restore.\n'
