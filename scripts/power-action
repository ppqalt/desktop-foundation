#!/usr/bin/env python3
"""Fixed native session actions; --check validates routing without acting."""
import argparse
import json
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parent.parent
commands = {
    'suspend': ['systemctl', 'suspend'],
    'logout': [str(root / 'scripts/session-exit')],
    'reboot': ['systemctl', 'reboot'],
    'poweroff': ['systemctl', 'poweroff'],
}
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=commands)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
if args.check:
    print(json.dumps(commands[args.action]))
else:
    raise SystemExit(subprocess.run(commands[args.action]).returncode)
