#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ${DF_COMPOSITOR:-niri} != niri || ! -S ${NIRI_SOCKET:-} ]]; then
	printf '%s\n' 'Desktop Foundation requires a Niri session.' >&2
	exit 1
fi
export QT_QPA_PLATFORMTHEME=gtk3
export GTK_THEME=adw-gtk3-dark
exec quickshell --no-duplicate --path "$root/shell"
