#!/usr/bin/env python3
"""Reversible greetd/PAM configuration; never restarts the display manager."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
STATE = Path('/var/lib/desktop-foundation/system')
HELPER = '/usr/local/libexec/desktop-foundation-oo7-ready'
READY_HOOK = 'session    [success=ok ignore=ignore default=1] pam_exec.so quiet type=open_session ' + HELPER + '\n'
FILES = {HELPER: ROOT / 'native/foundation/target/release/foundation-oo7-ready',
         '/etc/greetd/config.toml': ROOT / 'session/greetd/config.toml',
         '/etc/pam.d/greetd': ROOT / 'session/greetd/pam-greetd'}


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(journal, entries):
    atomic(journal, (json.dumps(entries, indent=2) + '\n').encode(), 0o600)


def secure_parents(path):
    for parent in path.parents:
        if parent.exists():
            info = parent.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                raise RuntimeError('System path parent must be a root-owned, non-writable directory: ' + str(parent))


def atomic(path, content, mode):
    secure_parents(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    descriptor, name = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            output.write(content)
            os.fchmod(output.fileno(), mode)
            os.fchown(output.fileno(), 0, 0)
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def source_bytes(name, source):
    limit = 16 * 1024 * 1024 if name == HELPER else 64 * 1024
    try:
        descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
                raise RuntimeError('Login source must be a bounded regular file: ' + str(source))
            content = stream.read(limit + 1)
    except OSError as error:
        raise RuntimeError('Build scripts/build-backend before installing login setup: ' + str(source)) from error
    if len(content) > limit:
        raise RuntimeError('Login source changed while reading: ' + str(source))
    if name == HELPER and not content.startswith(b'\x7fELF'):
        raise RuntimeError('The login readiness helper must be a built native executable')
    return content


@contextmanager
def transaction():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    secure_parents(STATE / 'lock')
    descriptor = os.open(STATE / 'lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
            raise RuntimeError('System deployment lock must be a private root-owned regular file')
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another login setup transaction is running; retry after it completes')
                time.sleep(0.05)
        yield
    finally:
        os.close(descriptor)


def validate_backups(entries):
    for entry in entries.values():
        if entry.get('backup'):
            backup = Path(entry['backup'])
            info = backup.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022
                    or digest(backup) != entry['original']):
                raise RuntimeError('Original login backup changed: ' + str(backup))


def perform(action):
    journal = STATE / 'manifest.json'
    secure_parents(journal)
    if journal.is_symlink():
        raise RuntimeError('System deployment journal must not be a symlink')
    entries = json.loads(journal.read_text()) if journal.exists() else {}
    validate_backups(entries)
    if action == 'install':
        sources = {name: source_bytes(name, source) for name, source in FILES.items()}
        subprocess.run(['pacman', '-Q', 'greetd', 'greetd-tuigreet', 'oo7', 'niri'], check=True)
        if not Path('/usr/lib/security/pam_oo7.so').is_file():
            raise RuntimeError('oo7 PAM module missing; system files unchanged')
        if not Path('/usr/share/wayland-sessions/niri.desktop').is_file():
            raise RuntimeError('Niri session entry missing')
        probe = subprocess.run(['tuigreet', '--background', 'matrix', '--dump-config'], capture_output=True, text=True)
        if probe.returncode or 'kind = "matrix"' not in probe.stdout:
            raise RuntimeError('Installed tuigreet does not support persistent Matrix animation; system files unchanged')
        display_manager = Path('/etc/systemd/system/display-manager.service')
        if display_manager.is_symlink() and display_manager.resolve().name != 'greetd.service':
            raise RuntimeError('Another display manager owns login; use --no-greeter. No login files changed.')
        # A manually installed file identical to our new template can be
        # adopted without replacing the original rollback backup. Check every
        # file first so an unrelated edit cannot leave a partial update.
        for name, content in sources.items():
            path = Path(name)
            secure_parents(path)
            if path.is_symlink():
                raise RuntimeError('System login target must not be a symlink: ' + name)
            accepted = {hashlib.sha256(content).hexdigest()}
            if name == '/etc/pam.d/greetd':
                # The previous exact oo7 template may have been installed
                # manually while the journal still records GNOME Keyring.
                legacy = content.replace(READY_HOOK.encode(), b'')
                accepted.add(hashlib.sha256(legacy).hexdigest())
            if name in entries:
                entry = entries[name]
                accepted.update(value for value in [entry['managed'], entry.get('pending'), entry.get('original')] if value)
                if not path.exists() and entry.get('backup') is None:
                    continue  # Interrupted first publication; no prior file.
                if not path.is_file() or path.is_symlink() or digest(path) not in accepted:
                    raise RuntimeError('Modified outside deployment: ' + name)
            if name == HELPER and path.exists():
                info = path.lstat()
                if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o6022:
                    raise RuntimeError('Installed readiness helper must be root-owned and non-writable')
        for name, content in sources.items():
            path = Path(name)
            if name not in entries:
                backup = STATE / path.name
                if path.exists():
                    shutil.copy2(path, backup)
                entries[name] = {'backup': str(backup) if path.exists() else None,
                                 'original': digest(backup) if path.exists() else None, 'managed': None}
            entries[name]['pending'] = hashlib.sha256(content).hexdigest()
            save(journal, entries)
            atomic(path, content, 0o755 if name == HELPER else 0o644)
            entries[name]['managed'] = entries[name].pop('pending')
            save(journal, entries)
        subprocess.run(['systemctl', 'enable', 'greetd.service'], check=True)
        print('Configured. Active display manager untouched. Log in with your password on next boot.')
    else:
        for name, entry in entries.items():
            path = Path(name)
            if not path.exists() and entry.get('backup') is None:
                continue
            if not path.is_file() or path.is_symlink() or digest(path) not in {entry['managed'], entry.get('pending'), entry.get('original')}:
                raise RuntimeError('Refusing to overwrite modified file: ' + name)
        # Restore PAM before removing the helper it invokes.
        for name, entry in sorted(entries.items(), key=lambda item: item[0] == HELPER):
            if entry['backup']:
                backup = Path(entry['backup'])
                atomic(Path(name), backup.read_bytes(), stat.S_IMODE(backup.stat().st_mode))
            else:
                Path(name).unlink(missing_ok=True)
        journal.unlink(missing_ok=True)
        print('Previous greetd/PAM files restored. Display manager service unchanged.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['install', 'restore'])
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Run with sudo; user deployment does not edit system authentication files')
    with transaction():
        perform(args.action)


if __name__ == '__main__':
    main()
