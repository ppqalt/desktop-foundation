#!/usr/bin/env bash
set -euo pipefail
source_path=${BASH_SOURCE[0]}
[[ $source_path == */* ]] || source_path=./$source_path
if [[ ${1:-} == launch ]]; then
	shift
	exec "${source_path%/*}/foundation" apps launch "$@"
fi
root=$(cd -- "${source_path%/*}/.." && pwd)
exec python3 "$root/scripts/application_roles.py" "$@"
