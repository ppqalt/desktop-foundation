#!/usr/bin/env bash
set -euo pipefail
[[ -S ${NIRI_SOCKET:-} ]] || {
	printf '%s\n' 'Niri socket unavailable.' >&2
	exit 1
}
DF_FOUNDATION_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export DF_FOUNDATION_ROOT
export DF_COMPOSITOR=niri
vars=(WAYLAND_DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP DF_COMPOSITOR DF_FOUNDATION_ROOT)
if [[ -n ${DISPLAY:-} ]]; then vars+=(DISPLAY); fi
systemctl --user unset-environment HYPRLAND_INSTANCE_SIGNATURE
dbus-update-activation-environment --systemd "${vars[@]}"
exec systemctl --user start --no-block desktop-foundation-session.target
