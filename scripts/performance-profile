#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
helper=/usr/local/libexec/desktop-foundation-performance
marker="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-foundation/performance-profile"
elevate=(sudo)
if [[ ${!#:-} == --gui-auth ]]; then
	set -- "${@:1:$(($# - 1))}"
	elevate=(pkexec)
fi
action=${1:-status}
case $action in
plan)
	exec /usr/bin/python3 -I "$root/scripts/performance_profile.py" plan
	;;
status)
	if [[ -f $marker && ! -L $marker ]] && [[ $(cat -- "$marker") == lucky38 ]]; then
		if cmp -s "$root/scripts/performance_profile.py" "$helper" && /usr/bin/python3 -I "$helper" check 2>/dev/null; then exit 0; fi
		printf '%s\n' 'Lucky38 selected; performance policy needs administrator reconciliation.'
		exit 3
	else
		printf '%s\n' 'Performance profile: off'
	fi
	exit 0
	;;
enable)
	[[ ${2:-} == lucky38 && $# == 2 ]] || {
		printf '%s\n' 'Usage: performance-profile enable lucky38' >&2
		exit 2
	}
	/usr/bin/python3 -I "$root/scripts/performance_profile.py" plan >/dev/null
	# Owner marker is written by Rust's private/atomic state helper below.
	"$root/scripts/foundation" performance-opt-in lucky38
	;;
verify) ;;
disable)
	if [[ ! -e $marker && ! -L $marker ]] || [[ -f $marker && ! -L $marker && $(cat -- "$marker") == off ]]; then
		"$root/scripts/foundation" performance-opt-in off
		exit 0
	fi
	;;
reconcile)
	[[ -f $marker && ! -L $marker && $(cat -- "$marker") == lucky38 ]] || exit 0
	elevate=(sudo -n)
	if cmp -s "$root/scripts/performance_profile.py" "$helper" && /usr/bin/python3 -I "$helper" check >/dev/null 2>&1; then exit 0; fi
	;;
*)
	printf '%s\n' 'Usage: performance-profile plan|enable lucky38|disable|verify|status|reconcile' >&2
	exit 2
	;;
esac
setup_helper() {
	"${elevate[@]}" /usr/bin/python3 -I - "$root/scripts/performance_profile.py" "$helper" <<'PY'
import os, pathlib, stat, sys, tempfile
source, target = map(pathlib.Path, sys.argv[1:])
for parent in reversed(target.parents):
    if not parent.exists():
        parent.mkdir(mode=0o755)
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Unprotected helper parent: ' + str(parent))
if target.exists() or target.is_symlink():
    info = target.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Unprotected helper target')
content = source.read_bytes()
if len(content) > 1024 * 1024:
    raise SystemExit('Oversized helper')
compile(content, str(target), 'exec')
fd, temporary = tempfile.mkstemp(dir=target.parent, prefix='.df-performance-')
try:
    with os.fdopen(fd, 'wb') as stream:
        stream.write(content)
        os.fchmod(stream.fileno(), 0o755)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, target)
    fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}
if ! setup_helper; then
	printf '%s\n' 'Lucky38 performance profile pending administrator authentication; desktop preserved.' >&2
	[[ $action == reconcile ]] && exit 0
	exit 1
fi
if [[ $action == verify ]]; then
	"${elevate[@]}" /usr/bin/python3 -I "$helper" verify-eac
elif [[ $action == disable ]]; then
	"${elevate[@]}" /usr/bin/python3 -I "$helper" restore
	"$root/scripts/foundation" performance-opt-in off
elif ! "${elevate[@]}" /usr/bin/python3 -I "$helper" apply; then
	printf '%s\n' 'Lucky38 performance reconciliation failed; journal retained. Inspect or restore before retrying.' >&2
	exit 1
fi
