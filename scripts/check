#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
mapfile -t scripts < <(rg -l '^#!/usr/bin/env bash' scripts terminal/fastfetch)
shellcheck "${scripts[@]}"
shfmt -d "${scripts[@]}"
mapfile -t qml < <(find shell -name '*.qml' -type f | sort)
/usr/lib/qt6/bin/qmllint -I /usr/lib/qt6/qml "${qml[@]}"
for file in "${qml[@]}"; do
	cmp "$file" <(/usr/lib/qt6/bin/qmlformat "$file")
done
while IFS= read -r file; do luac -p "$file"; done < <(find config -name '*.lua' -type f)
for command in rustc cargo rustfmt rust-analyzer; do "$command" --version; done
cargo clippy --version
for profile in default dual-display-example missing-profile; do
	"$root/scripts/preflight" --update --profile "$profile"
done
if [[ -f Cargo.toml ]]; then
	cargo fmt --check
	cargo clippy -- -D warnings
	cargo test
fi

cargo fmt --manifest-path native/nothing/Cargo.toml --check
cargo clippy --locked --manifest-path native/nothing/Cargo.toml --all-targets -- -D warnings
cargo test --locked --manifest-path native/nothing/Cargo.toml

cargo fmt --manifest-path native/foundation/Cargo.toml --check
cargo clippy --locked --manifest-path native/foundation/Cargo.toml --all-targets --all-features -- -D warnings
cargo test --locked --manifest-path native/foundation/Cargo.toml
