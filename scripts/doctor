#!/usr/bin/env python3
"""Read-only session diagnosis. Nonzero means an actionable failure."""
import json
import os
import shutil
import subprocess


def run(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=10)
    return result.returncode, result.stdout.strip()


def main():
    failures = []
    niri = bool(os.environ.get("NIRI_SOCKET"))
    for binary in [*([] if niri else ['Hyprland', 'hyprctl', 'uwsm']), 'quickshell', 'kitty', 'wl-copy', 'wl-paste', 'grim', 'slurp', 'jq', 'dbus-update-activation-environment', 'niri', 'xwayland-satellite']:
        if not shutil.which(binary):
            failures.append(f'Missing {binary}: run scripts/bootstrap')
    for variable in ['WAYLAND_DISPLAY', 'NIRI_SOCKET' if niri else 'HYPRLAND_INSTANCE_SIGNATURE', 'XDG_CURRENT_DESKTOP', 'XDG_RUNTIME_DIR']:
        if not os.environ.get(variable):
            failures.append(f'Missing {variable}: run from the active compositor session')
    for unit in [*(['desktop-foundation-clipboard-persist'] if niri else []), 'pipewire', 'pipewire-pulse', 'wireplumber', 'xdg-desktop-portal', *(['xdg-desktop-portal-gnome', 'xdg-desktop-portal-gtk'] if niri else ['xdg-desktop-portal-hyprland']), 'hyprpolkitagent', 'desktop-foundation-shell', 'desktop-foundation-clipboard@text', 'desktop-foundation-clipboard@image']:
        code, state = run('systemctl', '--user', 'is-active', unit + '.service')
        print(f'{unit}: {state}')
        if code:
            failures.append(f'{unit}: inspect journalctl --user -u {unit}.service; rerun scripts/session-start')
    code, instances = run('quickshell', 'list', '--json', '--path', str(__import__('pathlib').Path(__file__).resolve().parent.parent / 'shell'))
    if not code:
        try:
            count = len(json.loads(instances))
            print('Shell instances:', count)
            if count != 1:
                failures.append('Expected one shell instance: scripts/shell-stop then scripts/shell-start')
        except json.JSONDecodeError:
            failures.append('Unable to parse Quickshell instance list')
    if niri:
        from pathlib import Path
        for unit in ['desktop-foundation-wallpaper', 'desktop-foundation-clipboard-persist']:
            code, fragment = run('systemctl', '--user', 'show', unit + '.service', '--property=FragmentPath', '--value')
            if code or not fragment.startswith(str(Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'systemd/user') + '/'):
                failures.append(unit + ': persistent deployment unit missing; run scripts/deploy')
            code, enabled = run('systemctl', '--user', 'is-enabled', unit + '.service')
            if code or enabled != 'enabled':
                failures.append(unit + ': Niri session activation missing; run scripts/deploy')
        code, greeter = run('systemctl', 'is-active', 'greetd.service')
        if not code:
            pam = Path('/etc/pam.d/greetd').read_text()
            hooks = [line.split('#', 1)[0].split() for line in pam.splitlines()]
            auth = any(line and line[0] == 'auth' and 'pam_gnome_keyring.so' in line for line in hooks)
            session = any(line and line[0] == 'session' and 'pam_gnome_keyring.so' in line and 'auto_start' in line for line in hooks)
            if not auth or not session:
                failures.append('greetd keyring login unlock missing: sudo scripts/system-setup install, then password-login again')
        for process in ['swaybg', 'wl-clip-persist', 'gnome-keyring-daemon']:
            code, pids = run('pgrep', '-x', process if len(process) <= 15 else 'gnome-keyring-d')
            count = len(pids.splitlines()) if not code else 0
            print(process + ' instances:', count)
            if process != 'gnome-keyring-daemon' and count != 1 or process == 'gnome-keyring-daemon' and count > 1:
                failures.append(process + ': unexpected process count')
        code, failed = run('systemctl', '--user', '--failed', '--no-legend', '--plain')
        if failed:
            failures.append('Failed user services: ' + failed)
        code, state = run('systemctl', '--user', 'is-active', 'desktop-foundation-wallpaper.service')
        print('Niri wallpaper:', state)
        if code:
            failures.append('Niri wallpaper unavailable: check permanent image in compositor/niri/wallpaper.toml and wallpaper service journal')
        code, state = run('systemctl', '--user', 'is-active', 'desktop-foundation-notifications.service')
        print('Niri notifications:', state)
        if code:
            failures.append('Niri notifications unavailable: scripts/niri-notifications-start')
        code, preference = run('gsettings', 'get', 'org.gnome.desktop.interface', 'color-scheme')
        print('System color preference:', preference)
        if code or preference != "'prefer-dark'":
            failures.append('System dark preference inactive: scripts/dark-mode')
        code, reply = run('niri', 'msg', '-j', 'outputs')
        if code:
            failures.append('Niri IPC unavailable: check NIRI_SOCKET')
        config = str(__import__('pathlib').Path.home() / '.config/niri/config.kdl')
        code, errors = run('niri', 'validate', '-c', config)
        if code:
            failures.append('Niri config validation failed: ' + errors)
        code, status = run('quickshell', 'ipc', '--path', str(__import__('pathlib').Path(__file__).resolve().parent.parent / 'shell'), 'call', 'foundation', 'status')
        try:
            state = json.loads(status)
            layout = state['backendDiagnostics']['keyboardLayouts']
            print('Keyboard layouts:', layout)
            if not state['ready'] or state['backend'] != 'niri' or state['backendDiagnostics']['configFailed']:
                failures.append('Niri adapter not ready or config failed')
            if not layout or not any('Finnish' in name for name in layout.get('names', [])):
                failures.append('Finnish keyboard layout not reported by Niri')
        except (ValueError, KeyError, TypeError):
            failures.append('Niri shell diagnostics unavailable')
        print('Session: Niri primary/reference')
    else:
        code, keyboards = run('hyprctl', '-j', 'devices')
        if not code:
            devices = json.loads(keyboards)['keyboards']
            print('Keyboard layouts:', ', '.join(sorted({k['active_keymap'] for k in devices})))
            if not devices or any(k['active_keymap'] != 'Finnish' for k in devices):
                failures.append('Finnish layout not active on every keyboard: scripts/reload; check per-device overrides')
        else:
            failures.append('Hyprland IPC unavailable: inspect session environment; shell failure must not restart compositor')
        code, _ = run('uwsm', 'check', 'is-active', 'hyprland.desktop')
        print('Session:', 'UWSM managed' if not code else 'direct; select Hyprland (UWSM) at next physical login')
        code, errors = run('hyprctl', 'configerrors')
        if code or errors:
            failures.append('Config errors: ' + errors)
    for message in failures:
        print('FAIL:', message)
    print('HEALTHY' if not failures else f'{len(failures)} issue(s)')
    return bool(failures)


if __name__ == '__main__':
    raise SystemExit(main())
