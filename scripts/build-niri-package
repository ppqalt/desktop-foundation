#!/usr/bin/env bash
# Build only. Package installation and any session changes are separate actions.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
print_path=false
if (($# == 1)) && [[ $1 == --print-path ]]; then
	print_path=true
elif (($#)); then
	printf '%s\n' 'Usage: scripts/build-niri-package [--print-path]' >&2
	exit 2
fi
if ((EUID == 0)); then
	printf '%s\n' 'Build the Niri package as your normal user, not root.' >&2
	exit 1
fi
for tool in makepkg git cargo pacman; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Missing build tool: %s\n' "$tool" >&2
		exit 1
	fi
done
state_base=${XDG_STATE_HOME:-$HOME/.local/state}
[[ $state_base = /* ]] || {
	printf '%s\n' 'XDG_STATE_HOME must be absolute.' >&2
	exit 1
}
package_state="$state_base/desktop-foundation/niri-builds"
umask 077
mkdir -p -- "$package_state"
[[ -d $package_state && ! -L $package_state && -O $package_state ]] || {
	printf '%s\n' 'Niri build directory is not a private owned directory.' >&2
	exit 1
}
work=$(mktemp -d "$package_state/build.XXXXXXXX")
trap 'rm -r -- "$work"' EXIT
cp -- "$root/patches/niri/PKGBUILD" "$root/patches/niri/overview-ctrl-scroll.patch" "$work/"
mkdir -m 700 "$work/packages"
(
	cd -- "$work"
	if $print_path; then
		PKGDEST="$work/packages" env -u CARGO_TARGET_DIR makepkg --noconfirm >&2
	else
		PKGDEST="$work/packages" env -u CARGO_TARGET_DIR makepkg --noconfirm
	fi
)
mapfile -d '' packages < <(find "$work/packages" -maxdepth 1 -type f -name 'niri-foundation-*.pkg.tar.*' ! -name '*.sig' -print0)
if ((${#packages[@]} != 1)); then
	printf '%s\n' 'The Niri build did not produce exactly one package.' >&2
	exit 1
fi
name=$(pacman -Qp "${packages[0]}")
[[ $name == 'niri-foundation 26.04-1' ]] || {
	printf 'Unexpected package identity: %s\n' "$name" >&2
	exit 1
}
package_dir=$(mktemp -d "$package_state/package.XXXXXXXX")
chmod 700 "$package_dir"
# Publish the package name only after the full copy has completed.
cp -- "${packages[0]}" "$package_dir/.package.tmp"
mv -- "$package_dir/.package.tmp" "$package_dir/${packages[0]##*/}"
if $print_path; then
	printf '%s/%s\n' "$package_dir" "${packages[0]##*/}"
else
	printf 'Niri package built and verified: %s/%s\n' "$package_dir" "${packages[0]##*/}"
	printf '%s\n' 'Nothing was installed or changed in the active session.'
fi
