#!/usr/bin/env python3
"""Inert sample data for the standalone component gallery."""
import json
import sys
from pathlib import Path

args = sys.argv[1:]
if len(args) < 3 or args[0] != "--root":
    raise SystemExit("Expected gallery fixture root and action")
root = Path(args[1])
action = args[2:]
if action == ["wallpapers", "list"]:
    result = {"images": [{"path": f"sample-{i}", "name": f"Example {i}"} for i in range(1, 5)], "current": "sample-1"}
elif len(action) == 3 and action[:2] == ["wallpapers", "preview"] and action[2] in {f"sample-{i}" for i in range(1, 5)}:
    result = {"url": (root / "wallpapers/wallhaven-135w7w.png").resolve().as_uri()}
elif len(action) == 3 and action[:2] == ["theme-runtime", "wallpaper"] and action[2] in {f"sample-{i}" for i in range(1, 5)}:
    result = {"success": True}
else:
    raise SystemExit("Unsupported gallery fixture action")
print(json.dumps(result))
