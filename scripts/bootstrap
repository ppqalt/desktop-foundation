#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
mapfile -t packages < <(sed '/^#/d; /^$/d' "$root/packages/core.txt")
add_manifest() {
	local manifest
	mapfile -t manifest < <(sed '/^#/d; /^$/d' "$root/packages/$1.txt")
	packages+=("${manifest[@]}")
}
dev=false
for option in "$@"; do
	case $option in
	--hyprland) add_manifest hyprland ;;
	--greeter) add_manifest greeter ;;
	--personal) add_manifest personal ;;
	--dev)
		dev=true
		add_manifest dev
		;;
	*)
		printf 'Usage: %s [--hyprland] [--greeter] [--dev]\n' "$0" >&2
		exit 2
		;;
	esac
done
missing=()
for package in "${packages[@]}"; do
	if ! pacman -T "$package" >/dev/null 2>&1; then missing+=("$package"); fi
done
if ((${#missing[@]})); then
	# Full upgrade avoids unsupported partial upgrades on Arch/CachyOS.
	sudo pacman -Syu --needed "${missing[@]}"
fi
# CachyOS supplies this firmware bundle in its repository; plain Arch uses AUR.
mapfile -t firmware < <(sed '/^#/d; /^$/d' "$root/packages/firmware.txt")
for package in "${firmware[@]}"; do
	if pacman -T "$package" >/dev/null 2>&1; then continue; fi
	if pacman -Si "$package" >/dev/null 2>&1; then
		sudo pacman -Syu --needed "$package"
	else
		"$root/scripts/paru-bootstrap"
		paru -S --needed "$package"
	fi
done
rustup toolchain install 1.98.1 --profile minimal
if $dev; then
	rustup default stable
	rustup component add rustfmt clippy rust-analyzer
	for command in rustc cargo rustfmt rust-analyzer; do "$command" --version; done
	cargo clippy --version
	for tool in qmllint qmlformat qmlls qmlprofiler qsb; do test -x "/usr/lib/qt6/bin/$tool"; done
fi
sudo systemctl enable --now bluetooth.service
printf 'Dependencies ready. Install configuration: %s/scripts/install --no-packages\n' "$root"
