#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if ! command -v pacman >/dev/null 2>&1; then
	printf '%s\n' 'Bootstrapping requires pacman; install the required packages for your system manually.' >&2
	exit 1
fi
read_manifest() {
	local file="$root/packages/$1.toml" line value state=0
	local item_re='^[[:space:]]*"([a-zA-Z0-9][a-zA-Z0-9@._+-]*)",[[:space:]]*$'
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
		case $state in
		0)
			[[ $line == 'packages = [' ]] || {
				printf 'Invalid package manifest: %s\n' "$file" >&2
				return 1
			}
			state=1
			;;
		1)
			if [[ $line == ']' ]]; then
				state=2
			elif [[ $line =~ $item_re ]]; then
				value=${BASH_REMATCH[1]}
				((${#value} <= 128)) || return 1
				printf '%s\n' "$value"
			else
				printf 'Invalid package manifest: %s\n' "$file" >&2
				return 1
			fi
			;;
		*)
			printf 'Invalid package manifest: %s\n' "$file" >&2
			return 1
			;;
		esac
	done <"$file"
	[[ $state == 2 ]] || {
		printf 'Invalid package manifest: %s\n' "$file" >&2
		return 1
	}
}
contents=$(read_manifest core)
packages=()
if [[ -n $contents ]]; then mapfile -t packages <<<"$contents"; fi
add_manifest() {
	local manifest contents
	contents=$(read_manifest "$1") || return 1
	[[ -n $contents ]] || return 0
	mapfile -t manifest <<<"$contents"
	packages+=("${manifest[@]}")
}
dev=false
build_only=false
install_firmware=false
for option in "$@"; do
	case $option in
	--build-only) build_only=true ;;
	--greeter) add_manifest greeter ;;
	--personal) add_manifest personal ;;
	--firmware) install_firmware=true ;;
	--dev)
		dev=true
		add_manifest dev
		;;
	*)
		printf 'Usage: %s [--build-only] [--greeter] [--personal] [--firmware] [--dev]\n' "$0" >&2
		exit 2
		;;
	esac
done
if $build_only; then
	packages=(rustup gcc pkgconf sqlite dav1d wayland git)
fi
contents=''
if $install_firmware; then contents=$(read_manifest firmware); fi
firmware=()
if [[ -n $contents ]]; then mapfile -t firmware <<<"$contents"; fi
missing=()
for package in "${packages[@]}"; do
	if ! pacman -T "$package" >/dev/null 2>&1; then missing+=("$package"); fi
done
if ((${#missing[@]})); then
	# Full upgrade avoids unsupported partial upgrades on CachyOS.
	sudo pacman -Syu --needed "${missing[@]}"
fi
# Prefer the CachyOS firmware package from its configured signed repository.
for package in "${firmware[@]}"; do
	if pacman -T "$package" >/dev/null 2>&1; then continue; fi
	if pacman -Si "$package" >/dev/null 2>&1; then
		sudo pacman -Syu --needed "$package"
	else
		"$root/scripts/paru-bootstrap"
		paru -S --needed "$package"
	fi
done
# Reuse a complete pinned toolchain without contacting the release server.
# Check both tools: interrupted installations can leave only one usable binary.
if ! rustup run 1.98.1 rustc --version >/dev/null 2>&1 || ! rustup run 1.98.1 cargo --version >/dev/null 2>&1; then
	rustup toolchain install 1.98.1 --profile minimal
fi
if $dev; then
	rustup component add --toolchain 1.98.1 rustfmt clippy rust-analyzer
	for command in rustc cargo rustfmt rust-analyzer; do rustup run 1.98.1 "$command" --version; done
	rustup run 1.98.1 cargo clippy --version
	for tool in qmllint qmlformat qmlls qmlprofiler qsb; do test -x "/usr/lib/qt6/bin/$tool"; done
fi

printf 'Dependencies ready. Install configuration: %s/scripts/install --no-packages\n' "$root"
