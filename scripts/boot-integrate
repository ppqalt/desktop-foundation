#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
helper=/usr/local/libexec/desktop-foundation-boot
if (($# == 0)); then
	printf '%s\n' 'Usage: boot-integrate preflight|status [--admin], resume|repair|verify|finalize|restore-order|select-next|select-order|accept-lts|accept-snapshot' >&2
	exit 2
fi
action=$1
shift
admin=false
args=()
for arg in "$@"; do
	if [[ $arg == --admin ]]; then admin=true; else args+=("$arg"); fi
done
case $action in
preflight | plan | status)
	if $admin; then
		exec sudo /usr/bin/python3 -I "$root/scripts/boot_integration.py" "$action" "${args[@]}"
	fi
	exec /usr/bin/python3 -I "$root/scripts/boot_integration.py" "$action" "${args[@]}"
	;;
resume | repair | verify | finalize | restore-order | select-next | select-order | accept-lts | accept-snapshot) ;;
*)
	printf 'Unknown boot integration action: %s\n' "$action" >&2
	exit 2
	;;
esac
if [[ $action == resume || $action == repair ]]; then
	sudo /usr/bin/python3 -I "$root/scripts/boot_integration.py" preflight --summary "${args[@]}"
fi
# Install a protected standalone helper. Its privileged operations never import
# checkout modules or follow user-controlled paths. No firmware/package changes
# occur during helper installation; the helper repeats complete preflight.
sudo /usr/bin/python3 -I - "$root/scripts/boot_integration.py" "$helper" <<'PY'
import os, pathlib, stat, sys, tempfile
source, target = map(pathlib.Path, sys.argv[1:])
for parent in reversed(target.parents):
    if not parent.exists():
        parent.mkdir(mode=0o755)
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Unprotected helper parent: ' + str(parent))
if target.exists() or target.is_symlink():
    info = target.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Unprotected helper target')
content = source.read_bytes()
if len(content) > 1024 * 1024:
    raise SystemExit('Oversized helper')
compile(content, str(target), 'exec')
fd, temporary = tempfile.mkstemp(dir=target.parent, prefix='.df-boot-')
try:
    with os.fdopen(fd, 'wb') as stream:
        stream.write(content)
        os.fchmod(stream.fileno(), 0o755)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, target)
    fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
exec sudo /usr/bin/python3 -I "$helper" "$action" "${args[@]}"
