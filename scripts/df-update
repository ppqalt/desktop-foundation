#!/usr/bin/env bash
set -euo pipefail
# Installed as a symlink in ~/.local/bin; resolve the owning checkout first.
source_path=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(cd -- "${source_path%/*}/.." && pwd)
exec "$root/native/foundation/target/release/desktop-foundationctl" --root "$root" update "$@"
