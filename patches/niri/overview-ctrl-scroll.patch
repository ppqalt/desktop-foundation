 }
+
+#[test]
+fn overview_zoom_retargets_without_delay_or_workspace_movement() {
+    let mut clock = crate::animation::Clock::with_time(Duration::ZERO);
+    let mut layout: Layout<TestWindow> = Layout::new(clock.clone(), &Config::default());
+    layout.overview_open = true;
+    layout.overview_progress = Some(super::super::OverviewProgress::Open);
+    layout.animate_overview_zoom(0.6);
+    assert_eq!(layout.overview_zoom(), 0.5);
+    clock.set_unadjusted(Duration::from_millis(16));
+    layout.advance_animations();
+    let rendered = layout.overview_zoom();
+    assert!(rendered > 0.5 && rendered < 0.6);
+    layout.animate_overview_zoom(0.4);
+    assert_eq!(layout.overview_zoom(), rendered);
+    clock.set_unadjusted(Duration::from_millis(80));
+    layout.advance_animations();
+    assert!(layout.overview_zoom() > 0.4 && layout.overview_zoom() < rendered);
+    clock.set_unadjusted(Duration::from_millis(300));
+    layout.advance_animations();
+    assert_eq!(layout.overview_zoom(), 0.4);
+    assert!(layout.overview_zoom_animation.is_none());
+    layout.animate_overview_zoom(0.7);
+    let mut config = Config::default();
+    config.animations.off = true;
+    layout.update_config(&config);
+    assert_eq!(layout.overview_zoom(), 0.5);
+    layout.animate_overview_zoom(0.9);
+    assert_eq!(layout.overview_zoom(), 0.75);
+    assert!(layout.overview_zoom_animation.is_none());
+    layout.overview_progress = None;
+    assert_eq!(layout.overview_zoom(), 1.);
+}
