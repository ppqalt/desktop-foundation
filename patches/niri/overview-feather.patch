+#[test]
+fn overview_feather_follows_open_close_reversal_and_reduced_motion() {
+    let mut clock = crate::animation::Clock::with_time(Duration::ZERO);
+    let mut config = Config::default();
+    let mut layout: Layout<TestWindow> = Layout::new(clock.clone(), &config);
+    check_ops_on_layout(&mut layout, [Op::AddOutput(1)]);
+    let output = layout.outputs().next().unwrap().clone();
+    let width = |layout: &Layout<TestWindow>| {
+        layout
+            .monitor_for_output(&output)
+            .unwrap()
+            .overview_feather_width()
+    };
+    assert_eq!(width(&layout), 0.);
+    layout.open_overview();
+    assert_eq!(width(&layout), 0.);
+    clock.set_unadjusted(Duration::from_millis(60));
+    layout.advance_animations();
+    let partial = width(&layout);
+    assert!(partial > 0. && partial < 32.);
+    layout.close_overview();
+    assert_eq!(
+        width(&layout),
+        partial,
+        "Closing must continue from the rendered fade"
+    );
+    clock.set_unadjusted(Duration::from_millis(100));
+    layout.advance_animations();
+    assert!(width(&layout) < partial);
+    layout.open_overview();
+    clock.set_unadjusted(Duration::from_secs(2));
+    layout.advance_animations();
+    assert_eq!(width(&layout), 32.);
+    layout.close_overview();
+    clock.set_unadjusted(Duration::from_secs(4));
+    layout.advance_animations();
+    assert_eq!(width(&layout), 0.);
+    config.animations.off = true;
+    clock.set_complete_instantly(true);
+    layout.update_config(&config);
+    layout.open_overview();
+    layout.advance_animations();
+    assert_eq!(width(&layout), 32.);
+    layout.close_overview();
+    layout.advance_animations();
+    assert_eq!(width(&layout), 0.);
+}
