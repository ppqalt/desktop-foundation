+#version 100
+//_DEFINES_
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+uniform float alpha;
+varying vec2 v_coords;
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+uniform vec2 output_size;
+uniform vec4 workspace;
+uniform float feather_width;
+uniform float corner_radius;
+uniform float pixel_width;
+uniform vec4 backdrop_color;
+void main() {
+    vec2 point = v_coords * output_size - workspace.xy;
+    // Signed distance to the rounded workspace rectangle (negative inside).
+    vec2 half_size = workspace.zw * 0.5;
+    vec2 q = abs(point - half_size) - (half_size - vec2(corner_radius));
+    float distance_to_edge = length(max(q, vec2(0.0)))
+        + min(max(q.x, q.y), 0.0) - corner_radius;
+    float coverage;
+    if (feather_width > 0.0) {
+        // Fullscreen content: round and fade inward from that rounded boundary.
+        coverage = smoothstep(-feather_width, 0.0, distance_to_edge);
+    } else {
+        // Ordinary workspace: crisp rounded edge, with one physical pixel of AA.
+        coverage = smoothstep(-pixel_width * 0.5, pixel_width * 0.5, distance_to_edge);
+    }
+    if (coverage <= 0.0) discard;
+    vec4 color = texture2D(tex, v_coords);
+#if defined(NO_ALPHA)
+    color.a = 1.0;
+#endif
+    // Match Niri's backdrop composition, including the no-wallpaper fallback.
+    color += backdrop_color * (1.0 - color.a);
+    gl_FragColor = color * coverage * alpha;
+}
