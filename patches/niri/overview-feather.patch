new file mode 100644
index 0000000..ba416a0
--- /dev/null
+++ b/src/render_helpers/overview_feather.rs
@@ -0,0 +1,350 @@
+//! Blend the whole workspace perimeter into its existing overview backdrop.
+//! Compositing B * (1-f) over opaque C equals feathering C over B. Unlike fading
+//! individual surfaces, overlapping windows keep their original composition.
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use smithay::backend::renderer::element::{Element, Id, RenderElement};
+use smithay::backend::renderer::gles::{
+    GlesError, GlesFrame, GlesRenderer, GlesTexProgram, Uniform,
+};
+use smithay::backend::renderer::utils::{CommitCounter, DamageSet};
+use smithay::backend::renderer::Color32F;
+use smithay::utils::user_data::UserDataMap;
+use smithay::utils::{Buffer, Logical, Physical, Rectangle, Scale, Transform};
+
+use super::effect_buffer::EffectBuffer;
+use super::renderer::AsGlesFrame as _;
+use super::shaders::Shaders;
+use super::xray::Xray;
+use super::RenderCtx;
+use crate::backend::tty::{TtyFrame, TtyRenderer, TtyRendererError};
+
+#[derive(Debug)]
+pub struct OverviewFeatherElement {
+    id: Id,
+    buffer: Rc<RefCell<EffectBuffer>>,
+    program: GlesTexProgram,
+    geometry: Rectangle<f64, Logical>,
+    width: f64,
+    backdrop_color: Color32F,
+}
+
+pub fn render(
+    ctx: RenderCtx<GlesRenderer>,
+    xray: &Xray,
+    id: Id,
+    geometry: Rectangle<f64, Logical>,
+    width: f64,
+    push: &mut dyn FnMut(OverviewFeatherElement),
+) {
+    let Some(program) = Shaders::get(ctx.renderer).overview_feather.clone() else {
+        return;
+    };
+    // Prevent opposite fades from consuming small/strongly zoomed previews.
+    let width = width.min(geometry.size.w.min(geometry.size.h) / 4.);
+    if !width.is_finite() || width <= 0. {
+        return;
+    }
+    let buffer = xray.backdrop[ctx.target as usize].clone();
+    // Reuse the unblurred texture: DF's backdrop already contains its prepared
+    // blurred wallpaper. This must not introduce another blur or capture pass.
+    if !buffer.borrow_mut().prepare(ctx.renderer, false) {
+        return;
+    }
+    push(OverviewFeatherElement {
+        id,
+        buffer,
+        program,
+        geometry,
+        width,
+        backdrop_color: xray.backdrop_color,
+    });
+}
+
+impl Element for OverviewFeatherElement {
+    fn id(&self) -> &Id {
+        &self.id
+    }
+    fn current_commit(&self) -> CommitCounter {
+        self.buffer.borrow().commit()
+    }
+    fn geometry(&self, scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        self.geometry.to_physical_precise_round(scale)
+    }
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        let buffer = self.buffer.borrow();
+        self.geometry
+            .to_buffer(buffer.scale(), Transform::Normal, &buffer.logical_size())
+    }
+    fn damage_since(
+        &self,
+        scale: Scale<f64>,
+        _commit: Option<CommitCounter>,
+    ) -> DamageSet<i32, Physical> {
+        // Width changes during enter/exit even if backdrop commit stays fixed.
+        // Cover the maximum configurable perimeter, including the previous
+        // wider fade on close/reconfiguration. The center stays undamaged.
+        let size = self.geometry(scale).size;
+        if size.w <= 0 || size.h <= 0 {
+            return DamageSet::default();
+        }
+        let x = ((128. * scale.x).ceil() as i32).min((size.w + 1) / 2);
+        let y = ((128. * scale.y).ceil() as i32).min((size.h + 1) / 2);
+        DamageSet::from_slice(&[
+            Rectangle::new((0, 0).into(), (size.w, y).into()),
+            Rectangle::new((0, size.h - y).into(), (size.w, y).into()),
+            Rectangle::new((0, y).into(), (x, (size.h - 2 * y).max(0)).into()),
+            Rectangle::new((size.w - x, y).into(), (x, (size.h - 2 * y).max(0)).into()),
+        ])
+    }
+}
+
+impl RenderElement<GlesRenderer> for OverviewFeatherElement {
+    fn draw(
+        &self,
+        frame: &mut GlesFrame<'_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        _opaque_regions: &[Rectangle<i32, Physical>],
+        _cache: Option<&UserDataMap>,
+    ) -> Result<(), GlesError> {
+        let mut buffer = self.buffer.borrow_mut();
+        let texture = match buffer.render(frame, false) {
+            Ok(texture) => texture,
+            Err(err) => {
+                warn!("error rendering overview feather backdrop: {err:?}");
+                return Ok(());
+            }
+        };
+        let size = buffer.logical_size();
+        let geo = self.geometry;
+        let uniforms = [
+            Uniform::new("output_size", (size.w as f32, size.h as f32)),
+            Uniform::new(
+                "workspace",
+                (
+                    geo.loc.x as f32,
+                    geo.loc.y as f32,
+                    geo.size.w as f32,
+                    geo.size.h as f32,
+                ),
+            ),
+            Uniform::new("feather_width", self.width as f32),
+            Uniform::new("backdrop_color", self.backdrop_color.components()),
+        ];
+        frame.render_texture_from_to(
+            &texture,
+            src,
+            dst,
+            damage,
+            &[],
+            Transform::Normal,
+            1.,
+            Some(&self.program),
+            &uniforms,
+        )
+    }
+}
+
+impl<'render> RenderElement<TtyRenderer<'render>> for OverviewFeatherElement {
+    fn draw(
+        &self,
+        frame: &mut TtyFrame<'render, '_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        cache: Option<&UserDataMap>,
+    ) -> Result<(), TtyRendererError<'render>> {
+        RenderElement::<GlesRenderer>::draw(
+            self,
+            frame.as_gles_frame(),
+            src,
+            dst,
+            damage,
+            opaque_regions,
+            cache,
+        )?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::niri::OutputRenderElements;
+    use crate::render_helpers::solid_color::{SolidColorBuffer, SolidColorRenderElement};
+    use crate::render_helpers::{render_to_vec, resources, shaders, RenderTarget};
+    use smithay::backend::allocator::Fourcc;
+    use smithay::backend::egl::{native::EGLSurfacelessDisplay, EGLContext, EGLDisplay};
+    use smithay::backend::renderer::element::Kind;
+
+    #[test]
+    fn egl_overview_feather_blends_entire_perimeter_at_fractional_scales() {
+        let display = unsafe { EGLDisplay::new(EGLSurfacelessDisplay) }.unwrap();
+        let context = EGLContext::new(&display).unwrap();
+        let mut renderer = unsafe { GlesRenderer::new(context) }.unwrap();
+        resources::init(&mut renderer);
+        shaders::init(&mut renderer);
+        assert!(Shaders::get(&mut renderer).overview_feather.is_some());
+        for scale in [1., 1.5, 2.] {
+            let mut xray = Xray::new();
+            let color = Color32F::new(0.1, 0.2, 0.4, 1.);
+            xray.backdrop_color = color;
+            let base = SolidColorBuffer::new((640., 360.), color);
+            let lower = SolidColorBuffer::new((640., 180.), Color32F::new(0.4, 0.1, 0.2, 1.));
+            let workspace = SolidColorBuffer::new((320., 180.), Color32F::new(1., 1., 1., 1.));
+            let content = SolidColorBuffer::new((160., 180.), Color32F::new(0., 1., 0., 1.));
+            {
+                let mut buffer = xray.backdrop[0].borrow_mut();
+                buffer.update_size(
+                    ((640. * scale) as i32, (360. * scale) as i32).into(),
+                    scale.into(),
+                );
+                buffer.elements().push(
+                    SolidColorRenderElement::from_buffer(&lower, (0., 180.), 1., Kind::Unspecified)
+                        .into(),
+                );
+                buffer.elements().push(
+                    SolidColorRenderElement::from_buffer(&base, (0., 0.), 1., Kind::Unspecified)
+                        .into(),
+                );
+            }
+            let mut elements: Vec<OutputRenderElements<GlesRenderer>> = Vec::new();
+            render(
+                RenderCtx {
+                    renderer: &mut renderer,
+                    target: RenderTarget::Output,
+                    xray: None,
+                },
+                &xray,
+                Id::new(),
+                Rectangle::new((160., 90.).into(), (320., 180.).into()),
+                32.,
+                &mut |elem| elements.push(elem.into()),
+            );
+            assert_eq!(elements.len(), 1);
+            elements.push(
+                SolidColorRenderElement::from_buffer(&content, (160., 90.), 1., Kind::Unspecified)
+                    .into(),
+            );
+            elements.push(
+                SolidColorRenderElement::from_buffer(
+                    &workspace,
+                    (160., 90.),
+                    1.,
+                    Kind::Unspecified,
+                )
+                .into(),
+            );
+            elements.push(
+                SolidColorRenderElement::from_buffer(&lower, (0., 180.), 1., Kind::Unspecified)
+                    .into(),
+            );
+            elements.push(
+                SolidColorRenderElement::from_buffer(&base, (0., 0.), 1., Kind::Unspecified).into(),
+            );
+            let pixels = render_to_vec(
+                &mut renderer,
+                ((640. * scale) as i32, (360. * scale) as i32).into(),
+                scale.into(),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap();
+            let pixel = |x: f64, y: f64| {
+                let x = (x * scale) as usize;
+                let y = (y * scale) as usize;
+                let index = (y * (640. * scale) as usize + x) * 4;
+                &pixels[index..index + 4]
+            };
+            assert_eq!(
+                pixel(10., 10.),
+                pixel(639., 10.),
+                "Outside backdrop changed"
+            );
+            assert_eq!(
+                pixel(360., 180.),
+                &[255, 255, 255, 255],
+                "Center must remain sharp"
+            );
+            assert_eq!(
+                pixel(240., 180.),
+                &[0, 255, 0, 255],
+                "Inner content must remain intact"
+            );
+            // Both the wallpaper and a window reaching the edge must fade to B.
+            for point in [(160., 180.), (479., 180.), (360., 90.), (360., 269.)] {
+                for (actual, expected) in pixel(point.0, point.1).iter().zip(pixel(10., point.1)) {
+                    assert!(
+                        actual.abs_diff(*expected) <= 2,
+                        "Hard edge at {point:?}: {:?}",
+                        pixel(point.0, point.1)
+                    );
+                }
+            }
+            let quarter = pixel(164., 180.);
+            let half = pixel(176., 180.);
+            let inner = pixel(191., 180.);
+            assert!(
+                quarter[1] < half[1] && half[1] < inner[1],
+                "Fade must be gradual"
+            );
+            assert!(
+                half[0] > 0 && half[0] < 70,
+                "Window edge must blend, not just wallpaper"
+            );
+            if scale == 1. {
+                if let Some(path) = std::env::var_os("DF_FEATHER_ARTIFACT") {
+                    let mut encoder =
+                        png::Encoder::new(std::fs::File::create(path).unwrap(), 640, 360);
+                    encoder.set_color(png::ColorType::Rgba);
+                    encoder.set_depth(png::BitDepth::Eight);
+                    encoder
+                        .write_header()
+                        .unwrap()
+                        .write_image_data(&pixels)
+                        .unwrap();
+                }
+            }
+            elements.clear();
+            // Zero width creates no mask and leaves ordinary desktop rendering untouched.
+            render(
+                RenderCtx {
+                    renderer: &mut renderer,
+                    target: RenderTarget::Output,
+                    xray: None,
+                },
+                &xray,
+                Id::new(),
+                Rectangle::new((160., 90.).into(), (320., 180.).into()),
+                0.,
+                &mut |elem| elements.push(elem.into()),
+            );
+            assert!(elements.is_empty());
+        }
+    }
+
+    #[test]
+    fn overview_feather_configuration_validates_bounds() {
+        assert_eq!(
+            niri_config::Config::parse_mem("overview { workspace-feather 0; }")
+                .unwrap()
+                .overview
+                .workspace_feather,
+            0.
+        );
+        assert_eq!(
+            niri_config::Config::parse_mem("overview { workspace-feather 48; }")
+                .unwrap()
+                .overview
+                .workspace_feather,
+            48.
+        );
+        assert!(niri_config::Config::parse_mem("overview { workspace-feather -1; }").is_err());
+        assert!(niri_config::Config::parse_mem("overview { workspace-feather 129; }").is_err());
+    }
+}
