+#[test]
+fn egl_shadow_pixels_stay_inside_overview_wallpaper_without_hiding_window_content() {
+    let display = unsafe { EGLDisplay::new(EGLSurfacelessDisplay) }.unwrap();
+    let context = EGLContext::new(&display).unwrap();
+    let mut renderer = unsafe { GlesRenderer::new(context) }.unwrap();
+    resources::init(&mut renderer);
+    shaders::init(&mut renderer);
+    for scale in [1., 1.5, 2.] {
+        for zoom in [0.2, 0.5, 0.75] {
+            let mut config = Config::parse_mem(r##"
+                layout {
+                    focus-ring { off; }
+                    border { off; }
+                    shadow { on; softness 24; spread 8; color "#000000b3"; inactive-color "#000000b3"; }
+                }
+                animations { off; }
+            "##).unwrap();
+            config.overview.zoom = zoom;
+            let mut clock = Clock::with_time(Duration::ZERO);
+            clock.set_complete_instantly(true);
+            let mut layout = Layout::new(clock, &config);
+            check_ops_on_layout(
+                &mut layout,
+                [
+                    Op::AddScaledOutput {
+                        id: 1,
+                        scale,
+                        layout_config: None,
+                    },
+                    Op::AddWindow {
+                        params: TestWindowParams {
+                            is_floating: true,
+                            bbox: Rectangle::from_size((200, 120).into()),
+                            ..TestWindowParams::new(1)
+                        },
+                    },
+                    Op::Communicate(1),
+                    Op::AddWindow {
+                        params: TestWindowParams {
+                            is_floating: true,
+                            bbox: Rectangle::from_size((200, 120).into()),
+                            ..TestWindowParams::new(2)
+                        },
+                    },
+                    Op::Communicate(2),
+                ],
+            );
+            let output = layout.outputs().next().unwrap().clone();
+            let width = layout.monitor_for_output(&output).unwrap().view_size().w;
+            layout.move_floating_window(
+                Some(&1),
+                PositionChange::SetFixed(-25.),
+                PositionChange::SetFixed(50.),
+                false,
+            );
+            layout.move_floating_window(
+                Some(&2),
+                PositionChange::SetFixed(width - 100.),
+                PositionChange::SetFixed(50.),
+                false,
+            );
+            layout.open_overview();
+            layout.advance_animations();
+            let bounds = layout
+                .monitor_for_output(&output)
+                .unwrap()
+                .workspaces_with_render_geo()
+                .find(|(workspace, _)| workspace.has_windows())
+                .unwrap()
+                .1
+                .to_physical_precise_round(scale);
+            let with_shadow = frame(&mut layout, &mut renderer);
+            config.layout.shadow.on = false;
+            layout.update_config(&config);
+            let without_shadow = frame(&mut layout, &mut renderer);
+            let output_width = output.current_mode().unwrap().size.w as usize;
+            let mut interior_shadow = 0;
+            let mut outside_content = 0;
+            for (index, (before, after)) in with_shadow
+                .chunks_exact(4)
+                .zip(without_shadow.chunks_exact(4))
+                .enumerate()
+            {
+                let point =
+                    Point::from(((index % output_width) as i32, (index / output_width) as i32));
+                if bounds.contains(point) {
+                    if before != after {
+                        interior_shadow += 1;
+                    }
+                } else {
+                    assert_eq!(
+                        before, after,
+                        "Shadow escaped wallpaper at scale {scale}, zoom {zoom}, {point:?}"
+                    );
+                    if after[3] != 0 {
+                        outside_content += 1;
+                    }
+                }
+            }
+            assert!(interior_shadow > 0, "Interior shadows were removed");
+            assert!(
+                outside_content > 0,
+                "Horizontal window content was clipped along with shadows"
+            );
+        }
+    }
+}
