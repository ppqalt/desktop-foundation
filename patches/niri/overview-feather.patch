+#[test]
+fn overview_floating_drop_keeps_the_entire_window_reachable() {
+    for zoom in [0.2, 0.5, 0.85] {
+        let mut config = Config::default();
+        config.animations.off = true;
+        config.overview.zoom = zoom;
+        let mut layout: Layout<TestWindow> = Layout::new(Clock::with_time(Duration::ZERO), &config);
+        let mut params = TestWindowParams::new(1);
+        params.is_floating = true;
+        params.bbox = Rectangle::from_size((900, 600).into());
+        check_ops_on_layout(
+            &mut layout,
+            [
+                Op::AddOutput(1),
+                Op::AddWindow { params },
+                Op::Communicate(1),
+                Op::CompleteAnimations,
+            ],
+        );
+        layout.open_overview();
+        Op::CompleteAnimations.apply(&mut layout);
+        let output = layout.outputs().next().unwrap().clone();
+        let mon = layout.monitor_for_output(&output).unwrap();
+        let (ws, geo) = mon
+            .workspaces_with_render_geo()
+            .find(|(ws, _)| ws.has_window(&1))
+            .unwrap();
+        let ws_id = ws.id();
+        let (_, pos, _) = ws
+            .tiles_with_render_positions()
+            .find(|(t, _, _)| t.window().id() == &1)
+            .unwrap();
+        let start = geo.loc + (pos + Point::from((450., 550.))).upscale(zoom);
+        let end = geo.loc + Point::from((450., 20.)).upscale(zoom);
+        assert!(layout.interactive_move_begin(1, &output, start));
+        assert!(layout.interactive_move_update(&1, end - start, output.clone(), end));
+        layout.interactive_move_end(&1);
+        Op::CompleteAnimations.apply(&mut layout);
+        let (_, _, ws) = layout
+            .workspaces()
+            .find(|(_, _, ws)| ws.id() == ws_id)
+            .unwrap();
+        let (tile, pos, _) = ws
+            .tiles_with_render_positions()
+            .find(|(t, _, _)| t.window().id() == &1)
+            .unwrap();
+        let area = ws.working_area();
+        assert!(
+            pos.y >= area.loc.y,
+            "Dropped above workspace at zoom {zoom}: {pos:?}"
+        );
+        assert!(pos.x >= area.loc.x);
+        assert!(pos.y + tile.tile_size().h <= area.loc.y + area.size.h);
+        assert!(pos.x + tile.tile_size().w <= area.loc.x + area.size.w);
+    }
+}
