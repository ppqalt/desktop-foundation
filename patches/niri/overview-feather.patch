diff --git a/src/render_helpers/shaders/overview_feather.frag b/src/render_helpers/shaders/overview_feather.frag
new file mode 100644
index 0000000..6a2d9b2
--- /dev/null
+++ b/src/render_helpers/shaders/overview_feather.frag
@@ -0,0 +1,34 @@
+#version 100
+//_DEFINES_
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+uniform float alpha;
+varying vec2 v_coords;
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+uniform vec2 output_size;
+uniform vec4 workspace;
+uniform float feather_width;
+uniform vec4 backdrop_color;
+void main() {
+    vec2 point = v_coords * output_size - workspace.xy;
+    vec2 distance_to_edge = min(point, workspace.zw - point);
+    vec2 fade = smoothstep(vec2(0.0), vec2(feather_width), distance_to_edge);
+    float coverage = 1.0 - fade.x * fade.y;
+    if (coverage <= 0.0) discard;
+    vec4 color = texture2D(tex, v_coords);
+#if defined(NO_ALPHA)
+    color.a = 1.0;
+#endif
+    // Match Niri's backdrop composition, including the no-wallpaper fallback.
+    color += backdrop_color * (1.0 - color.a);
+    gl_FragColor = color * coverage * alpha;
+}
